status_bull_color = input.color(#18b311, '', inline = 'stclr', group = gstable, active = wm_show)
status_bear_color = input.color(#dc3d3d, '', inline = 'stclr', group = gstable, active = wm_show)
status_hl_color = input.color(#1b80e7, '', inline = 'stclr', group = gstable, active = wm_show)
wm_model_show = input.bool(true, 'MODEL', inline = 'stfld', group = gstable, active = wm_show)
wm_bias_show = input.bool(true, 'BIAS', inline = 'stfld', group = gstable, active = wm_show)
wm_auto_show = input.bool(true, 'AUTO', inline = 'stfld', group = gstable, active = wm_show)
