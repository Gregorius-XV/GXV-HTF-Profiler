//@version=6
indicator("✦ GXV HTF Profiler-PRO", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)
import Gregorius_XV/GXVAssetCorrelationUtils/1 as AC   
import Gregorius_XV/GXVUtils/12 as QTU
import Gregorius_XV/QTSmtFillEngine/13 as SMTF

// SMT module port: original GXV SMT Divergences-Lite v2.1.0 by Gregorius_XV (MPL-2.0).
// CISD: GXV CISD Model. HTF PSP: GXV Equinox Model. AUTO routing belongs to this host.
//==============================================================================
// Time declarations
//==============================================================================
tf = timeframe.period
tf_sec = timeframe.in_seconds(tf)
chart_tf_ms = tf_sec * 1000
TF_SEC_1 = timeframe.in_seconds("1")
TF_SEC_3 = timeframe.in_seconds("3")
TF_SEC_5 = timeframe.in_seconds("5")
TF_SEC_15 = timeframe.in_seconds("15")
TF_SEC_30 = timeframe.in_seconds("30")
TF_SEC_60 = timeframe.in_seconds("60")
TF_SEC_180 = timeframe.in_seconds("180")
TF_SEC_240 = timeframe.in_seconds("240")
TF_SEC_360 = timeframe.in_seconds("360")
TF_SEC_3M = timeframe.in_seconds("3M")
TF_SEC_D = timeframe.in_seconds("D")
TF_SEC_W = timeframe.in_seconds("W")
TF_SEC_M = timeframe.in_seconds("M")

//==============================================================================
// Groups
//==============================================================================
gGlobal = "1. Global Settings ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
gHTF = "2. HTF Settings ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
gHTFSmtPspFvg = "3. HTF Features ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
gHTFSetings = "4. General Settings ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
gCISD = "5. CISD ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
g_smt = "SMT ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
g_smt_gates = "SMT Gates Settings"
g_smt_ranks = "SMT Render Settings"
g_smt_styling = "SMT Syling Settings"
gHTFSMT = "HTF SMTs"
g_smt_assets = "SMT Asset Pair Resolver Settings"
g8 = "7. SMT-FILL ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
gKeyLevels = "8. Key Levels ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
gstable = "9. Status Table ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
gPerformance = "10. Performance  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"


//==============================================================================
// Inputs
//==============================================================================

global_text_color = input.color(#2e2e2e, 'Global Text Color', inline='gtxt', group = gGlobal)
global_mono_font = input.bool(false, 'Monospaced Font?', group = gGlobal)
global_font_family = global_mono_font ? font.family_monospace : font.family_default
bias_mode = input.string('Auto + Unbiased SMTs', 'Bias Engine', options = ['Off', 'Auto', 'Auto + Unbiased SMTs', 'Bullish', 'Bearish'], group = gGlobal)
bias_unbiased_smt = bias_mode == 'Auto + Unbiased SMTs'
bias_auto_mode = bias_mode == 'Auto' or bias_unbiased_smt
bias_off_mode = bias_mode == 'Off'
bias_bull_mode = bias_mode == 'Bullish'
bias_bear_mode = bias_mode == 'Bearish'
htf_sweeps_display = input.string('HTF Pane + Main', 'Sweep Display', options = ['HTF Pane Only', 'Main Chart Only', 'HTF Pane + Main'], group = gGlobal)

htf_sweep_color = input.color(#636363, 'Sweeps', inline='sweep', group=gGlobal)
htf_sweep_line_style = input.string('___', '', options=['___', '----', '....'], inline='sweep', group=gGlobal)
htf_sweep_display_cap = input.int(1, '', minval=1, maxval=25, inline='sweep', group=gGlobal, tooltip='Maximum displayed sweeps per HTF pane and direction. The latest valid confirmed formation reserves one slot; pending sweeps use only remaining slots. Detection history is independent of this display cap.')
htf_c3_closure = input.bool(false, 'C3 Closure Sweeps', inline='c3closure', group=gGlobal, tooltip='A failed C2 recovers only when C3 closes above C1 high (bullish) or below C1 low (bearish). Equal closes and wick-only breaches do not qualify. No pending C3 recovery is displayed.')
htf_c3_bull_color = input.color(#0096ff, '', inline='c3closure', group=gGlobal, active=htf_c3_closure)
htf_c3_bear_color = input.color(#f7525f, '', inline='c3closure', group=gGlobal, active=htf_c3_closure)

// HTF SETTINGS

htf_auto = input.bool(true, 'Auto HTF', inline = 'autohtf', group = gHTF)
htf_auto_count = input.bool(true, 'Auto Count', inline = 'autohtf', group = gHTF)
htf_auto_sequence = input.bool(false, 'Auto Sequence', inline = 'autohtf', group = gHTF, active = htf_auto, tooltip = 'Requires Auto HTF.')
htf_sequence_mode = input.string('GXT Sequence', 'Sequence Mode', options = ['Classic Sequence', 'GXT Sequence'], group = gHTF, active = htf_auto and not htf_auto_sequence)
auto_sequence_effective = htf_auto and htf_auto_sequence
htf_sweeps_tf_1_show = input.bool(true, 'HTF1', inline = 'TF1', group = gHTF)
htf_sweeps_tf_1_custom_tf = input.string('1h', '    ', options = ['3m', '5m', '15m', '30m', '90m', '1h', '2h', '3h', '4h', '6h', '12h', 'D', '3D', 'W', 'M', '3M', '6M', '12M'], inline = 'TF1', group = gHTF, active = not htf_auto)
htf_sweeps_tf_1_number = input.int(9, '', minval = 1, maxval = 60, inline = 'TF1', group = gHTF, active = not htf_auto_count)
htf_sweeps_tf_2_show = input.bool(true, 'HTF2', inline = 'TF2', group = gHTF)
htf_sweeps_tf_2_custom_tf = input.string('4h', '    ', options = ['3m', '5m', '15m', '30m', '90m', '1h', '2h', '3h', '4h', '6h', '12h', 'D', '3D', 'W', 'M', '3M', '6M', '12M'], inline = 'TF2', group = gHTF, active = not htf_auto)
htf_sweeps_tf_2_number = input.int(6, '', minval = 1, maxval = 60, inline = 'TF2', group = gHTF, active = not htf_auto_count)
htf_sweeps_tf_3_show = input.bool(true, 'HTF3', inline = 'TF3', group = gHTF)
htf_sweeps_tf_3_custom_tf = input.string('D', '    ', options = ['3m', '5m', '15m', '30m', '90m', '1h', '2h', '3h', '4h', '6h', '12h', 'D', '3D', 'W', 'M', '3M', '6M', '12M'], inline = 'TF3', group = gHTF, active = not htf_auto)
htf_sweeps_tf_3_number = input.int(3, '', minval = 1, maxval = 60, inline = 'TF3', group = gHTF, active = not htf_auto_count)
htf_custom_daily_open = input.bool(false, 'Custom Daily Open        ', inline = 'customdaily', group = gHTF)
htf_custom_daily_time = input.string('Midnight', '', options = ['Midnight', '18:00'], inline = 'customdaily', group = gHTF)

// HTF Features


htf_fvg_show = input.bool(true, 'Enable FVG?', inline = 'htffvg', group = gHTFSmtPspFvg)
htf_bull_fvg_color = input.color(#0096ff, '', inline = 'htffvg', group = gHTFSmtPspFvg)
htf_bear_fvg_color = input.color(#f7525f, '', inline = 'htffvg', group = gHTFSmtPspFvg)
htf_smt_show = input.bool(true, 'Enable SMT?', inline = 'htf_smt', group = gHTFSmtPspFvg)
smt_div_line_color2 = input.color(color.new(#0096ff, 50), '', inline = 'htf_smt', group = gHTFSmtPspFvg)
smt_div_line_color = input.color(color.new(#de5c5c, 50), '', inline = 'htf_smt', group = gHTFSmtPspFvg)
htf_psp_show = input.bool(true, 'Enable PSP?', inline = 'htf_psp', group = gHTFSmtPspFvg)
htf_psp_bull_color = input.color(color.new(#35b3ea, 20), '', inline = 'htf_psp', group = gHTFSmtPspFvg)
htf_psp_bear_color = input.color(color.new(#de5c5c, 20), '', inline = 'htf_psp', group = gHTFSmtPspFvg)
const string PSP_DISPLAY_LABEL = 'Label'
const string PSP_DISPLAY_BARCOLOR = 'Barcolor'
htf_psp_display = input.string(PSP_DISPLAY_LABEL, 'PSP Display', options=[PSP_DISPLAY_LABEL, PSP_DISPLAY_BARCOLOR], group=gHTFSmtPspFvg, active=htf_psp_show)
gC123 = 'HTF Features • C1-C2-C3 Labels'
htf_c123_show = input.bool(true, 'C1-C3 HTF Labels', group=gC123)
htf_c123_color = input.color(#2e2e2e, 'Label Color', group=gC123)
htf_c123_size = input.string(size.tiny, 'Label Size', options=[size.tiny,size.small,size.normal,size.large,size.huge], group=gC123)
// HTF Candles Filter: formation selection is shared with the displayed sweep cap.
gHtfFilter = 'HTF Features • HTF Candles Filter'
htf_filter_show = input.bool(false, 'HTF Candles Filter', inline='filter', group=gHtfFilter)
htf_filter_bull_color = input.color(#0096ff, '', inline='filter', group=gHtfFilter, active=htf_filter_show)
htf_filter_bear_color = input.color(#f7525f, '', inline='filter', group=gHtfFilter, active=htf_filter_show)
htf_filter_mode = input.string('0.5', 'Measurement Mode', options=['0.5','0.25'], group=gHtfFilter, active=htf_filter_show)
htf_filter_targets = input.string('C2-C5 Candles Only', 'Measuring Targets', options=['C2-C5 Candles Only','C2 Only'], group=gHtfFilter, active=htf_filter_show)
htf_filter_labels = input.bool(true, '0.5 / 0.25 Labels?', group=gHtfFilter, active=htf_filter_show)
htf_filter_zone = input.bool(false, 'Enable 0.5 / 0.25 Zone?', group=gHtfFilter, active=htf_filter_show)
htf_filter_style_input = input.string('Dotted', 'Line Style', options=['Solid','Dashed','Dotted'], group=gHtfFilter, active=htf_filter_show)
htf_filter_style = htf_filter_style_input == 'Solid' ? line.style_solid : htf_filter_style_input == 'Dashed' ? line.style_dashed : line.style_dotted
htf_filter_ratio = htf_filter_mode == '0.25' ? 0.25 : 0.5

// GENERAL SETTINGS

var bias_auto_dir = 0
var profiler_bias_state = array.new<int>(1, 0)
bias_engine_dir = bias_bull_mode ? 1 : bias_bear_mode ? -1 : bias_auto_mode ? bias_auto_dir : 0
bull_color = input.color(#f7f7f7, 'Body  ', inline = 'body', group = gHTFSetings)
bear_color = input.color(#616161, '', inline = 'body', group = gHTFSetings)
bull_border_color = input.color(#9c9c9c, 'Border ', inline = 'border', group = gHTFSetings)
bear_border_color = input.color(#4a4a4a, '', inline = 'border', group = gHTFSetings)
bull_wick_color = input.color(#9c9c9c, 'Wick  ', inline = 'wick', group = gHTFSetings)
bear_wick_color = input.color(#9c9c9c, '', inline = 'wick', group = gHTFSetings)

htf_sweeps_offset = input.int(25, 'Distance from Candles      ', group = gHTFSetings, minval = 1)
htf_sweeps_distance_between = input.int(10, 'Distance Between HTFs      ', group = gHTFSetings, minval = 2)
htf_candle_width_input = input.int(3, 'Candles Width          ', group = gHTFSetings, minval = 1, maxval = 5)
htf_candle_width = QTU.htfCandleWidth(htf_candle_width_input)
htf_label_show = input.bool(true, 'HTF Label                ', inline = 'htflbl', group = gHTFSetings)
htf_label_size = input.string(size.small, '', options = [size.tiny, size.small, size.normal, size.large, size.huge], inline = 'htflbl', group = gHTFSetings, active = htf_label_show)
htf_timer_show = input.bool(true, 'Remaining Time    ', inline = 'htftmr', group = gHTFSetings)
htf_timer_color = input.color(#9c9c9c, '', inline = 'htftmr', group = gHTFSetings)
htf_timer_size = input.string(size.small, '', options = [size.tiny, size.small, size.normal, size.large, size.huge], inline = 'htftmr', group = gHTFSetings, active = htf_timer_show)
htf_label_position = input.string('Both', 'Label Position', options = ['Both', 'Top', 'Bottom'], group = gHTFSetings)
htf_label_alignment = input.string('Align', 'Label Alignment', options = ['Align', 'Follow Candles'], group = gHTFSetings)

const int cisd_extend_bars = 5
const int cisd_max_candles = 5
const int CISD_EVENT_STATE_CAP = 64

cisd_show = input.bool(true, 'Enable CISD?', inline = 'CISD', group = gCISD)
cisd_display_cap = input.int(10, 'Display Cap', minval = 1, maxval = 50, group = gCISD, active = cisd_show)
cisd_render_mode_input = input.string('All', 'CISD Render Mode', options=['All', 'High Probability'], group=gCISD, active=cisd_show)
cisd_bull_clr = input.color(color.new(#4daae1, 0), '', inline = 'CISD', group = gCISD)
cisd_bear_clr = input.color(color.new(#cd0030, 0), '', inline = 'CISD', group = gCISD)
cisd_line_width = input.int(2, 'CISD Line Width', minval = 1, maxval = 5, group = gCISD, active = cisd_show)

cisd_early_show = input.bool(false, 'Early CISD', group = gCISD, active = cisd_show)
cisd_early_line_style_input = input.string('Dashed', 'Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'ECISD', group = gCISD, active = cisd_show and cisd_early_show)
cisd_early_line_width = input.int(1, 'Width', minval = 1, maxval = 5, inline = 'ECISD', group = gCISD, active = cisd_show and cisd_early_show)
cisd_early_line_style = cisd_early_line_style_input == 'Solid' ? line.style_solid : cisd_early_line_style_input == 'Dotted' ? line.style_dotted : line.style_dashed

const string TIP_DYNAMIC_SMT_LABELS = "When enabled, hides SMT labels on the exact chart timeframe used as that SMT family's maximum calculation gate. 3M and 12M labels are excluded."
const string TIP_CLEANUP = "Controls conflict handling. All removes lower-priority conflicts; Bypass modes keep conflicts but fade the bypassed SMT; None disables cleanup."
const string TIP_DISPLAY_CAP = "Maximum retained SMTs per timeframe, pair, and direction bucket."
const string TIP_NEARBY_ONLY = "Shows only SMTs whose endpoint is within the latest chart bars."
const string TIP_AESTHETIC_BYPASS = "In Bypass cleanup modes, keeps conflicting SMTs visible with lower contrast instead of fully removing them."
const string TIP_BYPASS_LABELS = "Shows labels on faded bypassed SMTs. Turn off for cleaner charts."

smt_txt_all = input.color(#4a4a4a, "SMT Text", inline="smt_txt", group=g_smt)
smt_label_size = input.string(size.tiny, "SMT Labels Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=g_smt)
smt_labels_show = input.bool(true, "SMT Labels?", group=g_smt)
smt_dynamic_labels = input.bool(true, "Dynamic SMT Labels?", group=g_smt, tooltip=TIP_DYNAMIC_SMT_LABELS)

smt_render_nearby_only = input.bool(false, "Render Gate?  ", group=g_smt_gates, tooltip=TIP_NEARBY_ONLY, inline='renderbars')
smt_nearby_bars = input.int(400, " ", minval=1, maxval=5000, group=g_smt_gates, active=smt_render_nearby_only, inline='renderbars')
smt_history_limit = input.int(20, "Display Cap", minval=1, maxval=100, group=g_smt_gates)
smt_monthly_min_tf = input.string("1 Hour", "Monthly SMTs TF ≥.", options=["None", "1 Hour", "4 Hour", "1 Day"], group=g_smt_gates)

smt_auto = input.bool(false, "Auto SMT?", group = g_smt_ranks, active = htf_auto, tooltip = "Requires Auto HTF. Intraday families follow the active Classic or GXT ladder; both ladders stay warm during Auto Sequence.")
smt_auto_effective = htf_auto and smt_auto
smt_15m_show = input.bool(false, "15m", inline="smt_r1", group=g_smt_ranks, active=not smt_auto_effective)
smt_15m_clr = input.color(#dbdbdb, "", inline="smt_r1", group=g_smt_ranks, active=not smt_auto_effective)
smt_30m_show = input.bool(true, "30m", inline="smt_r1", group=g_smt_ranks, active=not smt_auto_effective)
smt_30m_clr = input.color(#dbdbdb, "", inline="smt_r1", group=g_smt_ranks, active=not smt_auto_effective)
smt_1h_show = input.bool(true, "1H ", inline="smt_r1", group=g_smt_ranks, active=not smt_auto_effective)
smt_1h_clr = input.color(#dbdbdb, "", inline="smt_r1", group=g_smt_ranks, active=not smt_auto_effective)
smt_90m_show = input.bool(true, "90m", inline="smt_r2", group=g_smt_ranks, active=not smt_auto_effective)
smt_90m_clr = input.color(#dbdbdb, "", inline="smt_r2", group=g_smt_ranks, active=not smt_auto_effective)
smt_4h_show = input.bool(true, "4H ", inline="smt_r2", group=g_smt_ranks, active=not smt_auto_effective)
smt_4h_clr = input.color(#dbdbdb, "", inline="smt_r2", group=g_smt_ranks, active=not smt_auto_effective)
smt_6h_show = input.bool(true, "6H ", inline="smt_r2", group=g_smt_ranks, active=not smt_auto_effective)
smt_6h_clr = input.color(#dbdbdb, "", inline="smt_r2", group=g_smt_ranks, active=not smt_auto_effective)
smt_7h_show = input.bool(true, "7H ", inline="smt_r3", group=g_smt_ranks, active=not smt_auto_effective)
smt_7h_clr = input.color(#dbdbdb, "", inline="smt_r3", group=g_smt_ranks, active=not smt_auto_effective)
smt_12h_show = input.bool(true, "12H", inline="smt_r3", group=g_smt_ranks, active=not smt_auto_effective)
smt_12h_clr = input.color(#dbdbdb, "", inline="smt_r3", group=g_smt_ranks, active=not smt_auto_effective)
smt_1d_show = input.bool(true, "1D ", inline="smt_r3", group=g_smt_ranks)
smt_1d_clr = input.color(#b8b8b8, "", inline="smt_r3", group=g_smt_ranks)
smt_1w_show = input.bool(true, "1W ", inline="smt_r4", group=gHTFSMT)
smt_1w_clr = input.color(#b8b8b8, "", inline="smt_r4", group=gHTFSMT)
smt_1m_show = input.bool(false, "1M ", inline="smt_r4", group=gHTFSMT)
smt_1m_clr = input.color(#9c9c9c, "", inline="smt_r4", group=gHTFSMT)
smt_3m_show = input.bool(false, "3M ", inline="smt_r5", group=gHTFSMT)
smt_3m_clr = input.color(#636363, "", inline="smt_r5", group=gHTFSMT)
smt_12m_show = input.bool(false, "12M", inline="smt_r5", group=gHTFSMT)
smt_12m_clr = input.color(#2e2e2e, "", inline="smt_r5", group=gHTFSMT)

smt_line_style_input = input.string("___", "SMT Line Style", options=["___", "----", "...."], group=g_smt_styling)
smt_line_style = smt_line_style_input == "----" ? line.style_dashed : smt_line_style_input == "...." ? line.style_dotted : line.style_solid
smt_cleanup_mode = input.string("All", "SMT Cleanup", options=["All", "Bypass Pivot A", "Bypass Pivot B", "Bypass Inside Range", "None"], group=g_smt_styling, tooltip=TIP_CLEANUP)
smt_aesthetic_bypass = input.bool(true, "Aesthetic Bypass?", inline="smt_bypass", group=g_smt_styling, active=smt_cleanup_mode == "Bypass Pivot A" or smt_cleanup_mode == "Bypass Pivot B" or smt_cleanup_mode == "Bypass Inside Range", tooltip=TIP_AESTHETIC_BYPASS)
smt_bypass_labels_show = input.bool(false, "Bypass Labels?", inline="smt_bypass", group=g_smt_styling, active=smt_aesthetic_bypass and (smt_cleanup_mode == "Bypass Pivot A" or smt_cleanup_mode == "Bypass Pivot B" or smt_cleanup_mode == "Bypass Inside Range"), tooltip=TIP_BYPASS_LABELS)
smt_cleanup_pivot_a = smt_cleanup_mode != "Bypass Pivot A" and smt_cleanup_mode != "None"
smt_cleanup_pivot_b = smt_cleanup_mode != "Bypass Pivot B" and smt_cleanup_mode != "None"
smt_cleanup_inside = smt_cleanup_mode != "Bypass Inside Range" and smt_cleanup_mode != "None"
smt_render_current_day_only = input.bool(false, "Render Only Current Day Range    ", group=g_smt_gates)
smt_correlation_mode = input.string("Classic", "Correlation Mode", options=["GXT", "Classic", "Manual"], group=g_smt_assets)
smt_correlation_type = input.string("Triad", "Correlation Type", options=["Dyad", "Triad", "Tetrad"], group=g_smt_assets, active=smt_correlation_mode != "Manual")
manualCorrelation = smt_correlation_mode == "Manual"
manualPair1On = input.bool(true, 'Pair 1', inline='PAIR1', group=g_smt_assets, active=manualCorrelation)
manualPair1 = input.symbol('', '', inline='PAIR1', group=g_smt_assets, active=manualCorrelation and manualPair1On)
manualPair1Inverse = input.bool(false, 'Inverse', inline='PAIR1', group=g_smt_assets, active=manualCorrelation and manualPair1On)
manualPair2On = input.bool(true, 'Pair 2', inline='PAIR2', group=g_smt_assets, active=manualCorrelation)
manualPair2 = input.symbol('', '', inline='PAIR2', group=g_smt_assets, active=manualCorrelation and manualPair2On)
manualPair2Inverse = input.bool(false, 'Inverse', inline='PAIR2', group=g_smt_assets, active=manualCorrelation and manualPair2On)
manualPair3On = input.bool(false, 'Pair 3', inline='PAIR3', group=g_smt_assets, active=manualCorrelation)
manualPair3 = input.symbol('', '', inline='PAIR3', group=g_smt_assets, active=manualCorrelation and manualPair3On)
manualPair3Inverse = input.bool(false, 'Inverse', inline='PAIR3', group=g_smt_assets, active=manualCorrelation and manualPair3On)

// SMT-FILL

const string INVALID_SECONDARY = "__SMTF_INVALID_SECONDARY__"
const string INVALID_TERTIARY = "__SMTF_INVALID_TERTIARY__"
maxGapsInput = input.int(25, "Maximum Gaps", minval = 1, maxval = 100, group = g8)
extendFvgsToLastTouchInput = input.bool(true, "Extend FVGs till last touch", group = g8)
showOnlyCorrelatedInput = input.bool(false, "Show only correlated FVGs", group = g8)
hideFilledFvgsInput = input.bool(true, "Hide Filled FVGs", group = g8)
maxSmtFillsInput = input.int(25, "Maximum SMT Fills", minval=1, maxval=100, group=g8)
hideMitigatedFvgsInput = input.bool(false, "Hide Mitigated FVGs", group = g8)

showSmtFillLinesInput = input.bool(true, "Show SMT Fill Lines", group = g8)
smtFillLineWidthInput = input.int(1, "Line Width", minval = 1, maxval = 5, group = g8)
smtFillLineStyleInput = input.string("___", "Line Style", options = ["___", "----", "...."], group = g8)

showBullishGapsInput = input.bool(true, "Bullish Gaps?", group = g8, inline = "bull")
bullGapColorInput = input.color(#0096ff, "", group = g8, inline = "bull")
bullSmtFillLineColorInput = input.color(#0096ff, "+ SMT-F Line", group = g8, inline = "bull")
showBearishGapsInput = input.bool(true, "Bearish Gaps?", group = g8, inline = "bear")
bearGapColorInput = input.color(#f7525f, "", group = g8, inline = "bear")
bearSmtFillLineColorInput = input.color(#f7525f, "- SMT-F Line", group = g8, inline = "bear")

