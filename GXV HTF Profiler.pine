key_levels_offset = input.int(5, 'Offset', minval=0, maxval=50, group=gKeyLevels)
key_levels_high_show = input.bool(true, 'High', inline='key_high', group=gKeyLevels)
key_levels_high_color = input.color(#808080, '', inline='key_high', group=gKeyLevels)
key_levels_high_style = input.string('Solid', '', options=['Solid','Dashed','Dotted'], inline='key_high', group=gKeyLevels)
key_levels_low_show = input.bool(true, 'Low', inline='key_low', group=gKeyLevels)
key_levels_low_color = input.color(#808080, '', inline='key_low', group=gKeyLevels)
key_levels_low_style = input.string('Solid', '', options=['Solid','Dashed','Dotted'], inline='key_low', group=gKeyLevels)
key_levels_open_show = input.bool(false, 'Open', inline='key_open', group=gKeyLevels)
key_levels_open_color = input.color(#808080, '', inline='key_open', group=gKeyLevels)
key_levels_open_style = input.string('Solid', '', options=['Solid','Dashed','Dotted'], inline='key_open', group=gKeyLevels)
