key_levels_eq_color = input.color(#808080, '', inline='key_eq', group=gKeyLevels)
key_levels_eq_style = input.string('Solid', '', options=['Solid','Dashed','Dotted'], inline='key_eq', group=gKeyLevels)
const int Key_levels_line_wdith = 1

// Table inputs

wm_show = input.bool(true, 'Status Table              ', inline = 'gstats', group = gstable)
wm_position = input.string('Top Center', '', options = ['Bottom Center', 'Bottom Right', 'Top Center', 'Top Right'], inline = 'gstats', group = gstable, active = wm_show)
